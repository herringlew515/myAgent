# Copy this file to .env and supply your own API key.
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-6-astra

# Optional: URL of an OpenAI-compatible service supporting tool calling.
OPENAI_BASE_URL=https://cc2.caaa.tech/v1

# Model selection: set OPENAI_MODEL to the exact ID available from your provider.
# Restart the backend after changes. A different model is not guaranteed to be faster.

# Optional: outbound proxy used ONLY for model requests (keep it on the backend).
# MODEL_PROXY_URL=http://127.0.0.1:7890
# MODEL_PROXY_URL=socks5://127.0.0.1:7891

